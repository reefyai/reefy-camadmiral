+++ b/pkg/core/track_replace_test.go
@@ -0,0 +1,185 @@
+package core
+
+import (
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/pion/rtp"
+	"github.com/stretchr/testify/require"
+)
+
+func TestSenderReplacementBoundaryStaysBetweenSources(t *testing.T) {
+	codec := &Codec{Name: CodecH264, ClockRate: 90000}
+	media := &Media{
+		Kind:      KindVideo,
+		Direction: DirectionRecvonly,
+		Codecs:    []*Codec{codec},
+	}
+	oldReceiver := NewReceiver(media, codec)
+	newReceiver := NewReceiver(media, codec)
+	sender := NewSender(media, codec).WithParent(oldReceiver)
+
+	events := make(chan string, 3)
+	sender.Handler = func(packet *Packet) {
+		events <- string(packet.Payload)
+	}
+	sender.OnReplace(func() {
+		events <- "replace"
+	})
+
+	oldReceiver.Input(&rtp.Packet{Payload: []byte("old")})
+	oldReceiver.Replace(newReceiver)
+	newReceiver.Input(&rtp.Packet{Payload: []byte("new")})
+	sender.Start()
+	defer sender.Close()
+
+	for _, expected := range []string{"old", "replace", "new"} {
+		select {
+		case event := <-events:
+			require.Equal(t, expected, event)
+		case <-time.After(time.Second):
+			t.Fatal("timed out waiting for sender replacement event")
+		}
+	}
+}
+
+func TestReceiverReplacementWaitsForOldPacketDelivery(t *testing.T) {
+	codec := &Codec{Name: CodecH264, ClockRate: 90000}
+	media := &Media{
+		Kind:      KindVideo,
+		Direction: DirectionRecvonly,
+		Codecs:    []*Codec{codec},
+	}
+	oldReceiver := NewReceiver(media, codec)
+	newReceiver := NewReceiver(media, codec)
+	child := &Node{Codec: codec}
+	entered := make(chan struct{})
+	release := make(chan struct{})
+	events := make(chan string, 3)
+	var enteredOnce sync.Once
+	child.Input = func(packet *Packet) {
+		if string(packet.Payload) == "old" {
+			enteredOnce.Do(func() { close(entered) })
+			<-release
+		}
+		events <- string(packet.Payload)
+	}
+	child.OnReplace(func() { events <- "replace" })
+	child.WithParent(&oldReceiver.Node)
+
+	go oldReceiver.Input(&rtp.Packet{Payload: []byte("old")})
+	select {
+	case <-entered:
+	case <-time.After(time.Second):
+		t.Fatal("old packet did not enter receiver fan-out")
+	}
+
+	replaced := make(chan struct{})
+	go func() {
+		oldReceiver.Replace(newReceiver)
+		close(replaced)
+	}()
+	select {
+	case <-replaced:
+		t.Fatal("receiver replacement overtook an in-flight old packet")
+	case <-time.After(25 * time.Millisecond):
+	}
+
+	close(release)
+	require.Equal(t, "old", receiveCoreEvent(t, events))
+	require.Equal(t, "replace", receiveCoreEvent(t, events))
+	select {
+	case <-replaced:
+	case <-time.After(time.Second):
+		t.Fatal("receiver replacement did not complete")
+	}
+
+	newReceiver.Input(&rtp.Packet{Payload: []byte("new")})
+	require.Equal(t, "new", receiveCoreEvent(t, events))
+}
+
+func TestReceiverReplacementAndSenderCloseAreAtomic(t *testing.T) {
+	codec := &Codec{Name: CodecH264, ClockRate: 90000}
+	media := &Media{
+		Kind:      KindVideo,
+		Direction: DirectionRecvonly,
+		Codecs:    []*Codec{codec},
+	}
+	oldReceiver := NewReceiver(media, codec)
+	newReceiver := NewReceiver(media, codec)
+	sender := NewSender(media, codec).WithParent(oldReceiver)
+
+	// Hold the destination lock so replacement pauses after detaching the
+	// sender from the old receiver. Close must wait for the whole topology
+	// transaction rather than acting on the sender's stale parent.
+	newReceiver.mu.Lock()
+	destinationLocked := true
+	defer func() {
+		if destinationLocked {
+			newReceiver.mu.Unlock()
+		}
+	}()
+
+	replaced := make(chan struct{})
+	go func() {
+		oldReceiver.Replace(newReceiver)
+		close(replaced)
+	}()
+
+	require.Eventually(t, func() bool {
+		oldReceiver.mu.RLock()
+		defer oldReceiver.mu.RUnlock()
+		return len(oldReceiver.childs) == 0
+	}, time.Second, time.Millisecond)
+
+	closeStarted := make(chan struct{})
+	closed := make(chan struct{})
+	go func() {
+		close(closeStarted)
+		sender.Close()
+		close(closed)
+	}()
+	<-closeStarted
+	closedEarly := false
+	select {
+	case <-closed:
+		closedEarly = true
+	case <-time.After(25 * time.Millisecond):
+	}
+
+	newReceiver.mu.Unlock()
+	destinationLocked = false
+
+	select {
+	case <-replaced:
+	case <-time.After(time.Second):
+		t.Fatal("receiver replacement did not complete")
+	}
+	select {
+	case <-closed:
+	case <-time.After(time.Second):
+		t.Fatal("sender close did not complete")
+	}
+	require.False(t, closedEarly, "sender closed against a stale parent during replacement")
+
+	topologyMu.Lock()
+	parent := sender.parent
+	topologyMu.Unlock()
+	newReceiver.mu.RLock()
+	childCount := len(newReceiver.childs)
+	newReceiver.mu.RUnlock()
+	require.Nil(t, parent)
+	require.Zero(t, childCount)
+}
+
+func receiveCoreEvent(t *testing.T, events <-chan string) string {
+	t.Helper()
+	select {
+	case event := <-events:
+		return event
+	case <-time.After(time.Second):
+		t.Fatal("timed out waiting for receiver event")
+		return ""
+	}
+}
