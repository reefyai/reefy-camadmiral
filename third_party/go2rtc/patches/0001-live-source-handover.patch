new file mode 100644
index 0000000..b571c6e
--- /dev/null
+++ b/internal/streams/producer_replace_test.go
@@ -0,0 +1,141 @@
+package streams
+
+import (
+	"errors"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/AlexxIT/go2rtc/pkg/core"
+	"github.com/pion/rtp"
+	"github.com/stretchr/testify/require"
+)
+
+type replacementTestProducer struct {
+	media     *core.Media
+	receiver  *core.Receiver
+	started   chan struct{}
+	stopped   chan struct{}
+	startOnce sync.Once
+	stopOnce  sync.Once
+}
+
+func newReplacementTestProducer() *replacementTestProducer {
+	codec := &core.Codec{Name: core.CodecH264, ClockRate: 90000}
+	return &replacementTestProducer{
+		media: &core.Media{
+			Kind:      core.KindVideo,
+			Direction: core.DirectionRecvonly,
+			Codecs:    []*core.Codec{codec},
+		},
+		started: make(chan struct{}),
+		stopped: make(chan struct{}),
+	}
+}
+
+func (p *replacementTestProducer) GetMedias() []*core.Media {
+	return []*core.Media{p.media}
+}
+
+func (p *replacementTestProducer) GetTrack(
+	_ *core.Media, codec *core.Codec,
+) (*core.Receiver, error) {
+	if p.receiver == nil {
+		p.receiver = core.NewReceiver(p.media, codec)
+	}
+	return p.receiver, nil
+}
+
+func (p *replacementTestProducer) Start() error {
+	p.startOnce.Do(func() { close(p.started) })
+	<-p.stopped
+	return nil
+}
+
+func (p *replacementTestProducer) Stop() error {
+	p.stopOnce.Do(func() {
+		if p.receiver != nil {
+			p.receiver.Close()
+		}
+		close(p.stopped)
+	})
+	return nil
+}
+
+func receiveReplacementEvent(t *testing.T, events <-chan string) string {
+	t.Helper()
+	select {
+	case event := <-events:
+		return event
+	case <-time.After(time.Second):
+		t.Fatal("timed out waiting for replacement producer event")
+		return ""
+	}
+}
+
+func TestSetSourceMovesExistingSenderBeforeStoppingOldProducer(t *testing.T) {
+	oldProducer := newReplacementTestProducer()
+	newProducer := newReplacementTestProducer()
+	dialStarted := make(chan struct{})
+	allowDial := make(chan struct{})
+
+	HandleFunc("replacement-test", func(source string) (core.Producer, error) {
+		switch source {
+		case "replacement-test:old":
+			return oldProducer, nil
+		case "replacement-test:new":
+			close(dialStarted)
+			<-allowDial
+			return newProducer, nil
+		default:
+			return nil, errors.New("unexpected replacement test source")
+		}
+	})
+
+	producer := NewProducer("replacement-test:old")
+	require.NoError(t, producer.Dial())
+	oldTrack, err := producer.GetTrack(oldProducer.media, oldProducer.media.Codecs[0])
+	require.NoError(t, err)
+
+	events := make(chan string, 2)
+	sender := core.NewSender(oldProducer.media, oldProducer.media.Codecs[0])
+	sender.Handler = func(packet *core.Packet) { events <- string(packet.Payload) }
+	sender.HandleRTP(oldTrack)
+	producer.start()
+
+	select {
+	case <-oldProducer.started:
+	case <-time.After(time.Second):
+		t.Fatal("old producer did not start")
+	}
+	oldProducer.receiver.Input(&rtp.Packet{Payload: []byte("old")})
+	require.Equal(t, "old", receiveReplacementEvent(t, events))
+
+	producer.SetSource("replacement-test:new")
+	select {
+	case <-dialStarted:
+	case <-time.After(time.Second):
+		t.Fatal("replacement dial did not start")
+	}
+	select {
+	case <-oldProducer.stopped:
+		t.Fatal("old producer stopped before the replacement was prepared")
+	default:
+	}
+	close(allowDial)
+
+	select {
+	case <-newProducer.started:
+	case <-time.After(time.Second):
+		t.Fatal("new producer did not start")
+	}
+	select {
+	case <-oldProducer.stopped:
+	case <-time.After(time.Second):
+		t.Fatal("old producer did not stop after sender migration")
+	}
+
+	newProducer.receiver.Input(&rtp.Packet{Payload: []byte("new")})
+	require.Equal(t, "new", receiveReplacementEvent(t, events))
+	producer.stop()
+}
