+func TestPacketWriterResetsH264RepacketizerAtReplacement(t *testing.T) {
+	wire := new(continuityTestConn)
+	connection := &Conn{
+		state:      StatePlay,
+		playOK:     true,
+		conn:       wire,
+		PacketSize: 1200,
+	}
+	codec := &core.Codec{
+		Name:        core.CodecH264,
+		ClockRate:   90000,
+		PayloadType: 96,
+	}
+	handler, onReplace := connection.packetWriter(codec, 0, 96)
+
+	// Leave the old source halfway through a fragmented IDR NAL unit.
+	handler(&rtp.Packet{
+		Header:  rtp.Header{Version: 2, SequenceNumber: 10, Timestamp: 9000, SSRC: 111},
+		Payload: []byte{0x7c, 0x85, 'o', 'l', 'd'},
+	})
+	require.Empty(t, wire.Bytes())
+
+	onReplace()
+	handler(&rtp.Packet{
+		Header:  rtp.Header{Version: 2, SequenceNumber: 70, Timestamp: 100, SSRC: 222},
+		Payload: []byte{0x7c, 0x85, 'n', 'e', 'w', '-'},
+	})
+	handler(&rtp.Packet{
+		Header: rtp.Header{
+			Version:        2,
+			Marker:         true,
+			SequenceNumber: 71,
+			Timestamp:      100,
+			SSRC:           222,
+		},
+		Payload: []byte{0x7c, 0x45, 'i', 'd', 'r'},
+	})
+
+	packet := requireSingleInterleavedPacket(t, wire)
