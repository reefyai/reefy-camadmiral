+
+	data := wire.Bytes()
+	require.GreaterOrEqual(t, len(data), 4)
+	require.Equal(t, byte('$'), data[0])
+	require.Equal(t, int(data[2])<<8|int(data[3]), len(data)-4)
+	var packet rtp.Packet
+	require.NoError(t, packet.Unmarshal(data[4:]))
+	require.Equal(t, []byte("new-frame"), packet.Payload)
+	require.Equal(t, uint16(11), packet.SequenceNumber)
+	require.Equal(t, uint32(12000), packet.Timestamp)
+	require.Equal(t, uint32(111), packet.SSRC)
+}
