+	}
+	for _, sender := range senders {
+		matched := false
+		for _, media := range medias {
+			if media.Direction != core.DirectionSendonly ||
+				sender.Media == nil || media.Kind != sender.Media.Kind {
+				continue
+			}
+			codec := media.MatchCodec(sender.Codec)
+			if codec == nil {
+				continue
+			}
+			if err := consumer.AddTrack(media, codec, sender); err != nil {
+				return nil, err
+			}
+			matched = true
+			break
+		}
+		if !matched {
+			return nil, errors.New("streams: replacement source is missing an active backchannel")
+		}
+	}
