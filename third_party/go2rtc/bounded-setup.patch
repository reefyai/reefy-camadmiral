diff --git a/internal/streams/add_consumer.go b/internal/streams/add_consumer.go
index 7400ce6..d1abf26 100644
--- a/internal/streams/add_consumer.go
+++ b/internal/streams/add_consumer.go
@@ -7,7 +7,24 @@ import (
 	"github.com/AlexxIT/go2rtc/pkg/core"
 )
 
+// Limit setup work, not established readers. Keep admission until all cleanup
+// returns: pending can reach zero before stopProducers acquires a busy producer.
+const maxConsumerSetups = 16
+
+var errSetupBusy = errors.New("streams: upstream setup busy; retry later")
+
 func (s *Stream) AddConsumer(cons core.Consumer) (err error) {
+	for {
+		n := s.setups.Load()
+		if n >= maxConsumerSetups {
+			return errSetupBusy
+		}
+		if s.setups.CompareAndSwap(n, n+1) {
+			break
+		}
+	}
+	defer s.setups.Add(-1)
+
 	// support for multiple simultaneous pending from different consumers
 	consN := s.pending.Add(1) - 1
 
diff --git a/internal/streams/producer.go b/internal/streams/producer.go
index 09e2dcc..10f9d81 100644
--- a/internal/streams/producer.go
+++ b/internal/streams/producer.go
@@ -34,6 +34,9 @@ type Producer struct {
 	state    state
 	mu       sync.Mutex
 	workerID int
+	dialErr error
+	dialSource string
+	retryAfter time.Time
 }
 
 const SourceTemplate = "{input}"
@@ -59,11 +62,23 @@ func (p *Producer) Dial() error {
 	defer p.mu.Unlock()
 
 	if p.state == stateNone {
+		// Share failure/backoff with queued and subsequent callers. Otherwise
+		// every abandoned request performs another slow serial network dial.
+		if p.dialErr != nil && p.dialSource == p.url && time.Now().Before(p.retryAfter) {
+			return p.dialErr
+		}
 		conn, err := GetProducer(p.url)
 		if err != nil {
+			p.dialErr = err
+			p.dialSource = p.url
+			p.retryAfter = time.Now().Add(time.Second)
+			log.Warn().Err(err).Dur("retry_in", time.Second).
+				Msg("[streams] upstream setup failed; retry deferred")
 			return err
 		}
 
+		p.dialErr = nil
+		p.retryAfter = time.Time{}
 		p.conn = conn
 		p.state = stateMedias
 	}
